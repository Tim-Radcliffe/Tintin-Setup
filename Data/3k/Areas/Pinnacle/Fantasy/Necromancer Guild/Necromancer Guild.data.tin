        {^An Ancient Scroll Case$} 
        {
            {_area} {Pinnacle/Fantasy/Necromancer Guild}
            {desc} 
            {
                {1} {An Ancient Scroll Case}
                {2} {This is an ancient scroll case. Thanamere designed this case to}
                {3} {keep a constant environment to protect the scrolls. You may leave}
                {4} {scrolls in here for your brothers and sisters to use for battle.}
                {5} {Commands are: borrow <scroll || scroll type>, donate <scroll ||}
                {6} {scroll type>. Scrolls should never be taken and sold. That}
                {7} {would  be  sacrilegious!  Type 'list' to see what type of scrolls are}
                {8} {in the case}
                {9} {------------------------------------------------------------------------------}
                {10} {Contents of the case are:}
                {11} {Number         Description of scroll}
                {12} {------------- --------------------------------------------------------------}
                {13} {39            A necromantic scroll with the power 'shadow'                   }
                {14} {34            A necromantic scroll with the power 'illusion'                 }
                {15} {245           A necromantic scroll with the power 'chest'                    }
                {16} {87            A necromantic scroll with the power 'mouth'                    }
                {17} {214           A necromantic scroll with the power 'conjure undead'           }
                {18} {142           A necromantic scroll with the power 'rope trick'               }
                {19} {81            A necromantic scroll with the power 'skull scry'               }
                {20} {156           A necromantic scroll with the power 'snare'                    }
                {21} {100           A necromantic scroll with the power 'fright'                   }
                {22} {195           A necromantic scroll with the power 'alarm'                    }
                {23} {36            A necromantic scroll with the power 'dissolve'                 }
                {24} {220           A necromantic scroll with the power 'projection'               }
                {25} {------------------------------------------------------------------------------}
            }
            {id} {scroll case}
            {location} 
            {
                {Pinnacle/Fantasy/Necromancer Guild} 
                {
                    {40} {}
                }
            }
            {name} {An Ancient Scroll Case}
            {nomap} {}
            {pickup} {}
        }
