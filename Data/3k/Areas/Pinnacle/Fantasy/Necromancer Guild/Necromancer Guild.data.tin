                {20} {<O`[*****] a preserved, melted corpse of Baby dragon`> \x7B2\x7D.}
                {21} {<O`[*****] a preserved, melted corpse of Rabid wolf`> \x7B3\x7D.}
                {22} {<O`[*****] a preserved, melted corpse of Chubby vampire`>.}
                {23} {<O`[*****] a preserved, melted corpse of Sylvan elf`> \x7B2\x7D.}
                {24} {<O`[*****] a preserved, melted corpse of Ugly vampire`>.}
                {25} {<O`[*****] a preserved, sliced up corpse of Chubby vampire`>.}
            }
