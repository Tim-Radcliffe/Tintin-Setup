#NOP Handle dream;
#IF {@fIsNumber{$my[necromancer][tier]}}
{
    #VAR {_vDream[level]} {4};
    #SWITCH {$my[necromancer][tier]}
    {
        #CASE {5} {#MATH {_vDream[level]} {$_vDream[level] + 4};};
        #DEFAULT  {#MATH {_vDream[level]} {$_vDream[level] + $my[necromancer][tier]};};
    };
};
#ELSE 
{
    #MATH {_vDream[level]} {( $my[necromancer][level] - 36 ) / 6};
};

.gag add {necro.dream} {^\{@fDecToNumerals{$_vDream[level]}\}};
#UNVAR {_vDream};