#ALIAS {illume}
{
    #CLASS {necromancer_illume} {ASSIGN}
    {
        .gag set {necro.illume} {on};
        #ACTION {^The magical illumination fades from your body.$}
        {
            #LINE GAG;
            .gag set {necro.illume} {off};
            #CLASS {necromancer_illume} {KILL};
        };
    };
    #SEND {!illume};
};

.gag add {necro.illume} {^You call upon the material planes of energy to power your soul!$};
.gag set {necro.illume} {off};