#ALIAS {veil}
{
    #SWITCH {"%1"}
    {
        #CASE {"invoke"}
        {
            .gag set {necro.invoke.%*} {on};
            #VAR {my[necromancer][veil]} {ON};
        };
        #CASE {"disperse"}
        {
            .gag set {necro.invoke.%*} {off};
            #VAR {my[necromancer][veil]} {OFF};
        };
        #DEFAULT
        {
            #ECHO {ERROR: invoke %0 - unrecognised};
        };
    }
    #SEND {!veil %1};
};

#ALIAS {handler_veil}
{
    #NOP %1;
    #IF {"$opponent[data][undead]" == "1"} {#LOCAL {_hVeil[title]} {Necromancer Veil vs Undead}};
    #ELSE {#LOCAL {_hVeil[title]} {Necromancer Veil vs Living}};

    #IF {"%1" == "1"} {#LOCAL {_hVeil[type]} {BLOCK}};
    #ELSE {#LOCAL {_hVeil[type]} {DAMAGE REDUCTION}};

    .record_frequency {$_hVeil[type]} {$_hVeil[title]} {$_combat[attacks][incoming]} {incoming attacks};
    #IF {"$auto[necrogag][status]" == "1"} {#LINE GAG;};
};
event_register {e_gag_necro.invoke.block} {veil.tin} {#NOP %1;handler_veil {1};};
event_register {e_gag_necro.invoke.deflect} {veil.tin} {#NOP %1;handler_veil;};

.gag add {necro.invoke.block} {^Your veil of darkness completely negates the undead creature's attack!!$} 
.gag add {necro.invoke.block} {^/-= DEFLECT =-/$} 
.gag add {necro.invoke.block} {^The veil of darkness helps protect you from the abomination.$}
.gag add {necro.invoke.deflect} {^The shadowy powers of the veil partially deflect the assault.$}
.gag add {necro.invoke.deflect} {^You remain protected by the veil of darkness.$}
.gag add {necro.invoke.deflect} {^The veil of darkness protects you.$}
.gag add {necro.invoke.deflect} {^The shadowed veil protects you against the fiend.$}
.gag add {necro.invoke.deflect} {^The darkened veil absorbs part of the blow.$}
.gag add {necro.invoke.deflect} {^The creature battles against the veil of darkness.$}

.gag set {necro.invoke.%*} {off};