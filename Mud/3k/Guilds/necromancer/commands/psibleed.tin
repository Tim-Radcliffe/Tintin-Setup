#ALIAS {psibleed}
{
    #NOP %1;
    #CLASS {necromancer_psibleed} {ASSIGN}
    {
        #GAG {^Your iron will calls forth the powers of the material planes of energy.$};
        #GAG {^The crimson field engulfing %* dissolves away.$};

        #GAG {^You revel as the crimson energy feeds into your mind!$};
        #GAG {^The crimson energy feeds directly into your willing mind.$};
        #GAG {^The energy planes pull the power directly into your mind.$};
        #GAG {^Your magical energies are refreshed by the crimson psibleed.$};
        #GAG {^The crimson energy fills and refreshes your thirsty mind.$};
        #GAG {^Your mind is refreshed from the power of the psibleed.$};
        #GAG {^The pure crimson power flows directly into your open mind.$};

        #GAG {^The crimson energy wraps %* in a painful, agonizing torment.$};
        #GAG {^A crimson mist then appears and engulfs %*!$}; 
        #GAG {^%* mind is sapped into the crimson field of energy.$};
        #GAG {^%* is painfully drained by the crimson mist.$};
        #GAG {^%* staggers from the painful crimson energy mist.$};
        #GAG {^%* thoughts painfully dissipate into the crimson mist.$};
        #GAG {^%* mind and thoughts drain away into the crimson mist.$};
        #GAG {^The crimson energy field drains the mind of %*.$};
        #GAG {^You invade your enemy's mind with visions of death and despair!$};

        #ACTION {^>>>The psibleed upon %* has dissipated.$}
        {
            handler_psibleed_cleanup;
        };
        #ACTION {  Psibleed whom master?}
        {
            handler_psibleed_cleanup;
        };

        #ALIAS {handler_psibleed_cleanup}
        {
            #NOP %%1;
            #UNVAR {opponent[psibleed]};
            event_remove_specific {e_combat_finished} {$path[guild]/commands/psibleed.tin};
            #CLASS {necromancer_psibleed} {KILL};            
        };
        event_oneshot {e_combat_finished} {$path[guild]/commands/psibleed.tin} {#NOP %%1;handler_psibleed_cleanup;};
    };
    #VAR {opponent[psibleed]} {1};    
    #SEND {!psibleed %1};    
};