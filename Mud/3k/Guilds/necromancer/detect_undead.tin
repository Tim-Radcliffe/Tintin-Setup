#ALIAS {handler_auto_detectundead}
{
    #NOP %1;
    #IF {"%1" != ""}
	{
        #IF {"$%1[data][undead]" == ""}
        {
            #VAR {%1[data][undead]} {0};
            #CLASS {cNecromancerDetectUndead%5} {open};
            #ACTION {$%1[data][id] is undead...}
            {
                #VAR {%1[data][undead]} {1};
				.scanRoomNPCSave {%1[data]};               
            } {3};
            #ACTION {_necromancer.detect.undead.end.$%1[hash]}
            {
                #LINE GAG;
                #CLASS {cNecromancerDetectUndead$%1[hash]} {kill};
            } {2};
            #CLASS {cNecromancerDetectUndead$%1[hash]} {close};
            #SEND {!detect undead};
            #SEND {!_necromancer.detect.undead.end.$%1[hash]};            
        };
    };
};
event_register e_scan_room_npc {detect_undead.tin} {handler_auto_detectundead};

#NOP Shambling zombie is undead...                                                                                                                                                                                                     
#NOP   His power is weaker than yours.