#NOP Necromancer general gags;
.gag add {necro.atrance} {^-You activate your atrance-};
.gag add {necro.atrance} {^-Your atrance is complete-};
.gag add {necro.general} {^* You blink into unconsciousness *};
.gag add {necro.general} {^* You recover your senses *};
.gag add {necro.atrance} {^>>Atrancing};
.gag add {necro.familiar} {$my[necromancer][familiar][name] tells you:};
.gag add {necro.general} {^  You'll have to wait a moment %+.};
.gag add {necro.absorb} {^  You will now absorb corpses from %+ first %+.};
.gag add {necro.general} {^Shadowy powers compel you to %+};
.gag add {necro.general} {^Radiant energy races along %+ body.};
.gag add {necro.death} {^Death tells you:};
.gag add {necro.death} {^From afar, Death favors you.$};
.gag add {necro.death} {^  %+, my %+, I will embrace you soon.};
.gag add {necro.death} {^  Don't worry my %+, I always collect my debts...eventually.};
.gag add {necro.death} {^  I can feel you moving closer to me, my child.};
.gag add {necro.death} {^  I can wait for you %+.  I can wait a very long time.};
.gag add {necro.death} {^  Live onward my %+.};
.gag add {necro.death} {^  We will be together soon enough %+.};
.gag add {necro.death} {^  You escaped my grasp this time %+... this time.};
.gag add {necro.death} {^  Your destiny will wait a bit longer %+.};
.gag add {necro.invoke} {^C:O=|======> %*!$};