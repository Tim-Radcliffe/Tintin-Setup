#FOREACH {*craft_recipes_enchanter[]} {c}
{
    db_submit {temp[result]}
    {
        INSERT INTO craft_recipes (name, craft, min, max) 
        VALUES ('%s', '%s', '%s', '%s')
        RETURNING recnum
    }
    {$c}
    {Enchanter}
    {$craft_recipes_enchanter[$c][level][min]}
    {$craft_recipes_enchanter[$c][level][max]};
    #FOREACH {*craft_recipes_enchanter[$c][ingredients][]} {temp[i]}
    {
        db_submit {temp[result2]}
        {
            INSERT INTO craft_ingredients (recipenum, component, quantity) 
            VALUES ('%s', '%s', '%s')
        }
        {$temp[result][1][recnum]}
        {$temp[i]}
        {$craft_recipes_enchanter[$c][ingredients][$temp[i]]};
    };
}

