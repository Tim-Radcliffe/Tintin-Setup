#ALIAS {.scanRoomNPC}
{
	#IF {@fLocked{scan.%*}} {#RETURN};
	#LOCAL {_sRN[data]} {%5};
	#LOCAL {_sRN[match]} {$_sRN[data][path]};
	#IF {"$_sRN[data][nomap]" == "1"} {#RETURN};
	.debug SCAN {NPC Start: $_sRN[data][id]};    
	#FORMAT {_sRN[hash]} {%H} {$_sRN[data][id]};
	#VAR {%7[hash]} {$_sRN[hash]};

	#NOP    #LINE SUBSTITUTE VARIABLES {.RoomAddCommand {#VAR {_npc[$_sRN[match]]} {@fFormatNPCData{$_npc[$_sRN[match]]}}} {3}};
	#LINE SUBSTITUTE VARIABLES {.RoomAddCommand {.scanRoomNPCID       {%7} {$_sRN[hash]}} {3}};
	#LINE SUBSTITUTE VARIABLES {.RoomAddCommand {.scanRoomNPCDesc     {%7} {$_sRN[hash]}} {3}};
	#LINE SUBSTITUTE VARIABLES {.RoomAddCommand {.scanRoomNPCScaler   {%7} {$_sRN[hash]}} {3}};
	#NOP #LINE SUBSTITUTE VARIABLES {.RoomAddCommand {.scanRoomNPCLocation {$_sRN[match]} {%6}} {3}};
	#LINE SUBSTITUTE VARIABLES {.RoomAddCommand {.scanRoomNPCConsider {%7} {$_sRN[hash]}} {3}};
	#LINE SUBSTITUTE VARIABLES {.RoomAddCommand {event_raise {e_scan_room_npc} {%7} {$_sRN[hash]}} {4}};
};
event_register {e_room_npc} {h_scan_npc} {.scanRoomNPC};

#ALIAS {.scanRoomNPCID}
{
	#IF {"%1" != "" && ( &%1[data][id] == 0 || "$%1[data][id]" == "" ) }
	{
		#VAR {%1[data][id]} {$%1[id]};
		#VAR {%1[data][name]} {$%1[name]};
		.scanRoomNPCSave {%1} {%2};
		.debug SCAN {NPC ID Save $%1[id]};  
	};
};

#ALIAS {.scanRoomNPCDesc}
{
	#LOCAL {_sRND} {};
	#CLASS {cScanNPC%2} SIZE {_sRND};
	#IF {$_sRND == 0}
	{
		#CLASS {cScanNPC%2} {kill};
		#IF {"$%1[data][description]" == ""}
		{
			.Lock {room.scannpc.desc};
			#CLASS {cScanNPC%2} {assign}
			{
				#ACTION {_scan.room.npc.desc.%2}
				{
					#LINE GAG;
					#CLASS {cScanNPC%2} {assign}
					{
						#ACTION {{^(.*$)}}
						{
							#LIST {%1[data][description]} {add} {%%%0};
						} {2};
					};
				} {1};

				#ACTION {_scan.room.npc.desc.end.%2}
				{
					#LINE GAG;
					#CLASS {cScanNPC%2} {kill};
					#LIST {%1[data][description]} COLLAPSE {\n};
					.scanRoomNPCSave {%1} {%2};
					.debug SCAN {NPC Description Save $%1[id]};                      
					.Unlock {room.scannpc.desc};                    
				} {1};
			};

			#SEND {!_scan.room.npc.desc.%2};
			#IF {&%1[id] > 0}
			{
				#SEND {!exa $%1[id]};
			};
			#ELSE
			{
				#SEND {!exa $%1[name]};
			};
			#SEND {!_scan.room.npc.desc.end.%2};
		};
	};
};

#ALIAS {.scanRoomNPCScaler}
{
	#IF {"$%1[data][_area]" == "$map[area][path]" && ( "$%1[data][scaler]" == "0" || !@fIsNumber{$%1[data][scaler]})}
	{
		#VAR {%1[data][scaler]} {$map[area][scaler]};
		.scanRoomNPCSave {%1} {%2};
		.debug SCAN {NPC Scaler Save $%1[id]};          
	};
};

#ALIAS {.scanRoomNPCLocation}
{
	#IF {&map[area][path] > 0}
	{
		#IF {"$%1[data][_area]" == ""}
		{
			#VAR {%1[data][_area]} {$map[area][path]};
			.scanRoomNPCSave {%1} {%2};
		};
		#LOCAL {_scanRoomVnum} {};
		#MAP GET ROOMVNUM {_scanRoomVnum};
		#IF {&%1[location][$map[area][path]][$_scanRoomVnum] == 0}
		{
			#VAR {%1[location][$map[area][path]][$_scanRoomVnum]} {};
			.scanRoomNPCSave {%1} {%2};
			.debug SCAN {NPC Location Save $%1[id]};                       
		};
	};
};

#ALIAS {.scanRoomNPCConsider}
{
	#IF {"&%1[data][consider]" == "0" || "$%1[data][consider]" == ""}
	{
		.Lock {room.scannpc.consider};
		#ACTION {_scan.room.npc.consider.%2}
		{
			#LINE GAG;
			#ACTION {^Monster class: %*$}
			{
				#VAR {%1[data][consider]} {%%%1};
				.scanRoomNPCSave {%1} {%2};
				.debug SCAN {NPC Consider Save : %2};
				.Unlock {room.scannpc.consider};
				#UNACTION {^Monster class: %*$};
			};
			#UNACTION {_scan.room.npc.consider.%2};
		} {1};
		#SEND {!_scan.room.npc.consider.%2};
		#IF {&%1[id] > 0}
		{
			#SEND {!consider $%1[id]};
		};
		#ELSE
		{
			#SEND {!consider $%1[name]};
		};
	};
};

#ALIAS {.scanRoomNPCSave}
{
	.debug SCAN {NPC Save Trigger Added: %2};
	#IF {"$%1[data][nomap]" != "1" && &map[area][path] > 0}
	{
		#ACTION {_scan.room.npc.complete.%2}
		{
			#NOP %%1;
			#LINE GAG;
			.debug SCAN {NPC save: %2};
			.dbNPCSave {%1[data]};
			#UNACTION {_scan.room.npc.complete.%2};			
		};
		event_oneshot {e_roomscan_end} {h_scan_npc %2} {#NOP %%1;_scan.room.npc.complete.%2};
		#NOP event_oneshot {e_roomscan_finished} {h_scan_npc %1} {#NOP %%1;.debug SCAN {NPC save: $%1[id]};.dbNPCSave {%1};};
		#NOP .mapVariable add {_npc} {%1} {$_npc[$map[area][path]][%1]};
	};
};

#FUNCTION {fFormatNPCData}
{
	#NOP %1;
	#LOCAL {_npcData} {%0};
	#FOREACH {_area;alignment;attacks;autokill;desc;hunts;id;location;name;size;undead;vulnerabilities} {_f}
	{
		#IF {&_npcData[$_f] == 0}
		{
			#VAR {_npcData[$_f]} {};
		};
	};
	#UNVAR {_f};
	#RETURN {$_npcData};
};