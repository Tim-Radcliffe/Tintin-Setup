#ALIAS {.scanRoomNPC}
{
	#IF {@fLocked{scan.%*}} {#RETURN};
    #LOCAL {_sRN[data]} {%5};
	#LOCAL {_sRN[match]} {$_sRN[data][path]};
	#IF {"%5[nomap]" == "1"} {#RETURN};
    .debug SCAN {NPC: $_sRN[match]};    
	#FORMAT {_sRN[hash]} {%H} {$_sRN[match]};
    #VAR {%7[hash]} {$_sRN[hash]};
#NOP    #LINE SUBSTITUTE VARIABLES {.RoomAddCommand {#VAR {_npc[$_sRN[match]]} {@fFormatNPCData{$_npc[$_sRN[match]]}}} {3}};
	#LINE SUBSTITUTE VARIABLES {.RoomAddCommand {.scanRoomNPCID       {%7}} {3}};
	#LINE SUBSTITUTE VARIABLES {.RoomAddCommand {.scanRoomNPCDesc     {%7}} {3}};
	#LINE SUBSTITUTE VARIABLES {.RoomAddCommand {.scanRoomNPCLocation {$_sRN[match]} {%6}} {3}};
	#LINE SUBSTITUTE VARIABLES {.RoomAddCommand {.scanRoomNPCConsider {$_sRN[match]} {%3} {%2} {$_sRN[hash]} {%6}} {3}};
	#LINE SUBSTITUTE VARIABLES {.RoomAddCommand {event_raise {e_scan_room_npc} {$_sRN[match]} {%3} {%2} {$_sRN[hash]} {%6}} {4}};
};
event_register {e_room_npc} {h_scan_npc} {.scanRoomNPC};

#ALIAS {.scanRoomNPCID}
{
	#IF {"%1" != "" && ( &%1[data][id] == 0 || "$%1[data][id]" == "" ) }
	{
		#VAR {%1[data][id]} {$%1[id]};
		#VAR {%1[data][name]} {$%1[name]};
		.scanRoomNPCSave {%1[data]};
	};
};

#ALIAS {.scanRoomNPCDesc}
{
	#LOCAL {_sRND} {};
	#CLASS {cScanNPC$%1[hash]} SIZE {_sRND};
	#IF {$_sRND == 0}
	{
		#CLASS {cScanNPC$%1[hash]} {kill};
		#IF {"$%1[data][description]" == ""}
		{
            .Lock {room.scannpc.desc};
			#CLASS {cScanNPC$%1[hash]} {assign}
			{
				#ACTION {_scan.room.npc.desc.$%1[hash]}
				{
					#LINE GAG;
					#CLASS {cScanNPC$%1[hash]} {assign}
					{
						#ACTION {{^(.*$)}}
						{
							#LIST {%1[data][desc]} {add} {%%%0};
						} {2};
					};
				} {1};

				#ACTION {_scan.room.npc.desc.end.$%1[hash]}
				{
					#LINE GAG;
					#CLASS {cScanNPC$%1[hash]} {kill};
					.scanRoomNPCSave {%1[data]};
                    .Unlock {room.scannpc.desc};                    
				} {1};
			};

			#SEND {!_scan.room.npc.desc.$%1[hash]};
			#IF {&%1[id] > 0}
			{
				#SEND {!exa $%1[id]};
			};
			#ELSE
			{
				#SEND {!exa $%1[name]};
			};
			#SEND {!_scan.room.npc.desc.end.$%1[hash]};
		};
	};
};

#ALIAS {.scanRoomNPCLocation}
{
	#IF {&map[area][path] > 0}
	{
		#IF {"$%1[data][_area]" == ""}
		{
			#VAR {%1[data][_area]} {$map[area][path]};
			.scanRoomNPCSave {%1[data]};
        };
		#LOCAL {_scanRoomVnum} {};
		#MAP GET ROOMVNUM {_scanRoomVnum};
		#IF {&%1[location][$map[area][path]][$_scanRoomVnum] == 0}
		{
			#VAR {%1[location][$map[area][path]][$_scanRoomVnum]} {};
			.scanRoomNPCSave {%1[data]};            
		};
	};
};

#ALIAS {.scanRoomNPCConsider}
{
	#IF {&map[area][scaler] == 0}
	{
		#VAR {map[area][scaler]} {0};
	};
	#IF {"&%1[size][$map[area][scaler]][consider]" == "0"}
	{
        .Lock {room.scannpc.consider};
		#ACTION {_scan.room.npc.consider.%4}
		{
			#LINE GAG;
			#ACTION {^Monster class: %*$}
			{
				#VAR {%1[size][$map[area][scaler]][consider]} {%%%1};
				.scanRoomNPCSave {%1[data]};
                .Unlock {room.scannpc.consider};                
				#UNACTION {^Monster class: %*$};
			};
			#UNACTION {_scan.room.npc.consider.%4};
		} {1};
		#SEND {!_scan.room.npc.consider.%4};
		#IF {&%1[id] > 0}
		{
			#SEND {!consider $%1[id]};
		};
		#ELSE
		{
			#SEND {!consider %3};
		};
	};
};

#ALIAS {.scanRoomNPCSave}
{
    .debug SCAN {NPC Save: %1};
	#IF {"$%1[nomap]" != "1" && &map[area][path] > 0}
	{
        event_oneshot {e_roomscan_finished} {h_scan_npc %1} {#NOP %%1;.debug SCAN {NPC save: $%1[id]};.dbNPCSave {%1};};
		#NOP .mapVariable add {_npc} {%1} {$_npc[$map[area][path]][%1]};
	};
};

#FUNCTION {fFormatNPCData}
{
	#NOP %1;
	#LOCAL {_npcData} {%0};
	#FOREACH {_area;alignment;attacks;autokill;desc;hunts;id;location;name;size;undead;vulnerabilities} {_f}
	{
		#IF {&_npcData[$_f] == 0}
		{
			#VAR {_npcData[$_f]} {};
		};
	};
	#UNVAR {_f};
	#RETURN {$_npcData};
};