#NOP #GAG {^A flare of light from your shades puts};
#NOP #GAG {^Light flashes off your shades, briefly distracting};
#NOP #GAG {%* is distracted by seeing %w reflection in your shades.};

#ACTION {{^A flare of light from your shades puts|^Light flashes off your shades, briefly distracting|.* is distracted by seeing .* reflection in your shades.}}
{
    #LINE GAG;
    #LOCAL {_eqShades} {*my[eq][%* shades]};
    #IF {"$_eqShades" == ""}
    {
        #RETURN;
    };
    .record_frequency {DAMAGE REDUCTION} {$_eqShades} {$_combat[attacks][incoming]} {incoming attacks};
};