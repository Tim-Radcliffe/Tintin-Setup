#NOP Granular dynamic gag handling
#NOP Balthus - 23/04/2025;
#NOP This gags mud output while at the same time raising an event in case the output is needed to trigger functionality
#NOP Groups of gags can be turned on/off with wildcards as long as they are given suitably similar types
#NOP .gag add {type} {match string};
#NOP .gag set {type} {on/off};
#NOP .gag check {type};

#ALIAS {.gag}
{
    #SWITCH {"%1"}
    {
        #CASE {"add"}
        {
            #LIST {_gag[on][%2]} ADD {%3};
            .gag_setup add {%2} {%3};
        };
        #CASE {"set"}
        {
            #IF {"%3" == "on"}
            {
                #FOREACH {*_gag[off][%2]} {_gag[type]}
                {
                    #FOREACH {$_gag[off][$_gag[type]][]} {_gag[match]}
                    {
                        .gag_setup add {$_gag[type]} {$_gag[match]};                     
                        #LIST {_gag[on][$_gag[type]]} ADD {$_gag[match]};
                    };
                };
                #UNVAR {_gag[off][%2]};
            };
            #ELSEIF {"%3" == "off"}
            {
                #FOREACH {*_gag[on][%2]} {_gag[type]}
                {
                    #FOREACH {$_gag[on][$_gag[type]][]} {_gag[match]}
                    {
                        .gag_setup delete {$_gag[type]} {$_gag[match]};                          
                        #LIST {_gag[off][$_gag[type]]} ADD {$_gag[match]};
                    };
                };
                #UNVAR {_gag[on][%2]};
            };
            #ELSE 
            {
                #ECHO {#ERROR .gag set %2 %3 - Command malformed};
            };
            #UNVAR {_gag[type]};
            #UNVAR {_gag[match]};            
        };
        #DEFAULT 
        {
            #FOREACH {*_gag[on][%2]} {_gag[type]}
            {
                #FOREACH {$_gag[on][$_gag[type]][]} {_gag[match]}
                {
                    #LIST {_gag[output][list]} ADD {{{Set} {<128>on<098>} {Type} {$_gag[type]} {Match} {@fTrunc{{$_gag[match]}{40}}}}};
                };
            };
            #FOREACH {*_gag[off][%2]} {_gag[type]}
            {
                #FOREACH {$_gag[off][$_gag[type]][]} {_gag[match]}
                {
                    #LIST {_gag[output][list]} ADD {{{Set} {<118>off<098>} {Type} {$_gag[type]} {Match} {@fTrunc{{$_gag[match]}{40}}}}};
                };
            };
            #LOCAL {_gag[output][table]} {@fTable{$_gag[output][list]}};
            #LIST {_gag[output][table]} COLLAPSE {\n};
            #ECHO {$_gag[output][table]};
            #UNVAR {_gag[output]};
            #UNVAR {_gag[type]};
            #UNVAR {_gag[match]};                   
        };
    };
};

#ALIAS {.gag_setup}
{
    #IF {"%1" == "add"}
    {
        #ACTION {%3}
        {
            #NOP %%1;
            #LINE GAG;
            event_raise {e_gag_%2} {%%0};        
        };
    };
    #ELSE
    {
        #UNACTION {%3};
    };
};