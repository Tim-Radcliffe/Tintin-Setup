#NOP Granular dynamic gag handling
#NOP Balthus - 23/04/2025;
#NOP .gag add {type} {match string};
#NOP .gag set {type} {on/off};
#NOP .gag check {type};

#ALIAS {.gag}
{
    #SWITCH {"%1"}
    {
        #CASE {"add"}
        {
            #LIST {_gag[on][%2]} ADD {%3};
            #GAG {%3};
        };
        #CASE {"set"}
        {
            #IF {"%3" == "on"}
            {
                #FOREACH {*_gag[off][%2]} {_gag[type]}
                {
                    #FOREACH {$_gag[off][$_gag[type]][]} {_gag[match]}
                    {
                        #GAG {$_gag[match]};
                        #LIST {_gag[on][$_gag[type]]} ADD {$_gag[match]};
                    };
                };
                #UNVAR {_gag[off][%2]};
            };
            #ELSEIF {"%3" == "off"}
            {
                #FOREACH {*_gag[on][%2]} {_gag[type]}
                {
                    #FOREACH {$_gag[on][$_gag[type]][]} {_gag[match]}
                    {
                        #UNGAG {$_gag[match]};
                        #LIST {_gag[off][$_gag[type]]} ADD {$_gag[match]};
                    };
                };
                #UNVAR {_gag[on][%2]};
            };
            #ELSE 
            {
                #ECHO {#ERROR .gag set %2 %3 - Command malformed};
            };
            #UNVAR {_gag[type]};
            #UNVAR {_gag[match]};            
        };
        #DEFAULT 
        {
            #FOREACH {*_gag[on][%2]} {_gag[type]}
            {
                #FOREACH {$_gag[on][$_gag[type]][]} {_gag[match]}
                {
                    #LIST {_gag[output][list]} ADD {{{setting} {<128>on<098>} {type} {$_gag[type]} {match} {$_gag[match]}}};
                };
            };
            #FOREACH {*_gag[off][%2]} {_gag[type]}
            {
                #FOREACH {$_gag[off][$_gag[type]][]} {_gag[match]}
                {
                    #LIST {_gag[output][list]} ADD {{{setting} {<118>off<098>} {type} {$_gag[type]} {match} {$_gag[match]}}};
                };
            };
            #LOCAL {_gag[output][table]} {@fTable{$_gag[output][list]}};
            #LIST {_gag[output][table]} COLLAPSE {\n};
            #ECHO {$_gag[output][table]};
            #UNVAR {_gag[output]};
            #UNVAR {_gag[type]};
            #UNVAR {_gag[match]};                   
        };
    };
};